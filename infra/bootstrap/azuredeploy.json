{
  "$schema": "https://schema.management.azure.com/schemas/2018-05-01/subscriptionDeploymentTemplate.json#",
  "contentVersion": "1.0.0.0",
  "metadata": {
    "_generator": {
      "name": "bicep",
      "version": "0.48.1.52935",
      "templateHash": "9483726975577160231"
    }
  },
  "parameters": {
    "location": {
      "type": "string",
      "defaultValue": "indonesiacentral",
      "metadata": {
        "description": "Region for the resource group and the identity."
      }
    },
    "resourceGroupName": {
      "type": "string",
      "defaultValue": "rg-contoso-health-aks",
      "metadata": {
        "description": "Resource group that holds every resource of the demo."
      }
    },
    "identityName": {
      "type": "string",
      "defaultValue": "id-github-contoso-health",
      "metadata": {
        "description": "Name of the user-assigned managed identity used by GitHub Actions."
      }
    },
    "githubOwner": {
      "type": "string",
      "metadata": {
        "description": "GitHub account or organization that owns the repository."
      }
    },
    "githubOwnerId": {
      "type": "string",
      "metadata": {
        "description": "Numeric ID of the owner: https://api.github.com/repos/OWNER/REPO -> owner.id"
      }
    },
    "githubRepo": {
      "type": "string",
      "defaultValue": "contoso-health-aks-demo",
      "metadata": {
        "description": "Repository name."
      }
    },
    "githubRepoId": {
      "type": "string",
      "metadata": {
        "description": "Numeric ID of the repository: https://api.github.com/repos/OWNER/REPO -> id"
      }
    },
    "subjectFormat": {
      "type": "string",
      "defaultValue": "immutable",
      "metadata": {
        "description": "Subject format of the GitHub OIDC token: \"immutable\" (repo:OWNER@OWNER_ID/REPO@REPO_ID:...) or \"classic\" (repo:OWNER/REPO:...). Check the subject claim in a workflow run log if unsure."
      }
    },
    "environmentName": {
      "type": "string",
      "defaultValue": "production",
      "metadata": {
        "description": "GitHub environment that gates deployments."
      }
    },
    "mainBranch": {
      "type": "string",
      "defaultValue": "main",
      "metadata": {
        "description": "Branch that builds images and runs the demo jobs."
      }
    },
    "tags": {
      "type": "object",
      "defaultValue": {
        "workload": "contoso-health",
        "environment": "demo",
        "cost-center": "demo"
      },
      "metadata": {
        "description": "Tags for the resource group and the identity."
      }
    }
  },
  "variables": {
    "repoSubjectPrefix": "[if(equals(toLower(parameters('subjectFormat')), 'classic'), format('repo:{0}/{1}', parameters('githubOwner'), parameters('githubRepo')), format('repo:{0}@{1}/{2}@{3}', parameters('githubOwner'), parameters('githubOwnerId'), parameters('githubRepo'), parameters('githubRepoId')))]"
  },
  "resources": [
    {
      "type": "Microsoft.Resources/resourceGroups",
      "apiVersion": "2024-03-01",
      "name": "[parameters('resourceGroupName')]",
      "location": "[parameters('location')]",
      "tags": "[parameters('tags')]"
    },
    {
      "type": "Microsoft.Resources/deployments",
      "apiVersion": "2025-04-01",
      "name": "github-identity",
      "resourceGroup": "[parameters('resourceGroupName')]",
      "properties": {
        "expressionEvaluationOptions": {
          "scope": "inner"
        },
        "mode": "Incremental",
        "parameters": {
          "location": {
            "value": "[parameters('location')]"
          },
          "tags": {
            "value": "[parameters('tags')]"
          },
          "identityName": {
            "value": "[parameters('identityName')]"
          },
          "repoSubjectPrefix": {
            "value": "[variables('repoSubjectPrefix')]"
          },
          "environmentName": {
            "value": "[parameters('environmentName')]"
          },
          "mainBranch": {
            "value": "[parameters('mainBranch')]"
          }
        },
        "template": {
          "$schema": "https://schema.management.azure.com/schemas/2019-04-01/deploymentTemplate.json#",
          "contentVersion": "1.0.0.0",
          "metadata": {
            "_generator": {
              "name": "bicep",
              "version": "0.48.1.52935",
              "templateHash": "9581125551869830173"
            }
          },
          "parameters": {
            "location": {
              "type": "string"
            },
            "tags": {
              "type": "object"
            },
            "identityName": {
              "type": "string"
            },
            "repoSubjectPrefix": {
              "type": "string",
              "metadata": {
                "description": "Subject prefix, for example repo:OWNER@OWNER_ID/REPO@REPO_ID"
              }
            },
            "environmentName": {
              "type": "string"
            },
            "mainBranch": {
              "type": "string"
            }
          },
          "variables": {
            "roles": {
              "contributor": "b24988ac-6180-42a0-ab88-20f7382dd24c",
              "resourcePolicyContributor": "36243c78-bf99-498c-9df9-86d9f8d28608",
              "rbacAdministrator": "f58310d9-a9f6-439a-9e8d-f62e7b41a168",
              "acrPull": "7f951dda-4ed3-4680-a7ca-43fe172d538d",
              "aksRbacClusterAdmin": "b1ff04bb-8a4e-4dc4-8eb5-8693973ce19b"
            },
            "credentials": [
              {
                "name": "[format('github-environment-{0}', parameters('environmentName'))]",
                "subject": "[format('{0}:environment:{1}', parameters('repoSubjectPrefix'), parameters('environmentName'))]"
              },
              {
                "name": "github-pull-request",
                "subject": "[format('{0}:pull_request', parameters('repoSubjectPrefix'))]"
              },
              {
                "name": "[format('github-branch-{0}', parameters('mainBranch'))]",
                "subject": "[format('{0}:ref:refs/heads/{1}', parameters('repoSubjectPrefix'), parameters('mainBranch'))]"
              }
            ],
            "delegatedRoles": "[format('{0}, {1}', variables('roles').acrPull, variables('roles').aksRbacClusterAdmin)]",
            "principalTypes": "'User', 'ServicePrincipal'",
            "rbacCondition": "[format('((!(ActionMatches{{''Microsoft.Authorization/roleAssignments/write''}})) OR (@Request[Microsoft.Authorization/roleAssignments:RoleDefinitionId] ForAnyOfAnyValues:GuidEquals {{{0}}} AND @Request[Microsoft.Authorization/roleAssignments:PrincipalType] ForAnyOfAnyValues:StringEqualsIgnoreCase {{{1}}})) AND ((!(ActionMatches{{''Microsoft.Authorization/roleAssignments/delete''}})) OR (@Resource[Microsoft.Authorization/roleAssignments:RoleDefinitionId] ForAnyOfAnyValues:GuidEquals {{{2}}} AND @Resource[Microsoft.Authorization/roleAssignments:PrincipalType] ForAnyOfAnyValues:StringEqualsIgnoreCase {{{3}}}))', variables('delegatedRoles'), variables('principalTypes'), variables('delegatedRoles'), variables('principalTypes'))]"
          },
          "resources": [
            {
              "type": "Microsoft.ManagedIdentity/userAssignedIdentities",
              "apiVersion": "2023-01-31",
              "name": "[parameters('identityName')]",
              "location": "[parameters('location')]",
              "tags": "[parameters('tags')]"
            },
            {
              "copy": {
                "name": "federatedCredentials",
                "count": "[length(variables('credentials'))]",
                "mode": "serial",
                "batchSize": 1
              },
              "type": "Microsoft.ManagedIdentity/userAssignedIdentities/federatedIdentityCredentials",
              "apiVersion": "2023-01-31",
              "name": "[format('{0}/{1}', parameters('identityName'), variables('credentials')[copyIndex()].name)]",
              "properties": {
                "issuer": "https://token.actions.githubusercontent.com",
                "subject": "[variables('credentials')[copyIndex()].subject]",
                "audiences": [
                  "api://AzureADTokenExchange"
                ]
              },
              "dependsOn": [
                "[resourceId('Microsoft.ManagedIdentity/userAssignedIdentities', parameters('identityName'))]"
              ]
            },
            {
              "type": "Microsoft.Authorization/roleAssignments",
              "apiVersion": "2022-04-01",
              "name": "[guid(resourceGroup().id, resourceId('Microsoft.ManagedIdentity/userAssignedIdentities', parameters('identityName')), variables('roles').contributor)]",
              "properties": {
                "roleDefinitionId": "[subscriptionResourceId('Microsoft.Authorization/roleDefinitions', variables('roles').contributor)]",
                "principalId": "[reference(resourceId('Microsoft.ManagedIdentity/userAssignedIdentities', parameters('identityName')), '2023-01-31').principalId]",
                "principalType": "ServicePrincipal",
                "description": "GitHub Actions: deploy the platform Bicep template and push images."
              },
              "dependsOn": [
                "[resourceId('Microsoft.ManagedIdentity/userAssignedIdentities', parameters('identityName'))]"
              ]
            },
            {
              "type": "Microsoft.Authorization/roleAssignments",
              "apiVersion": "2022-04-01",
              "name": "[guid(resourceGroup().id, resourceId('Microsoft.ManagedIdentity/userAssignedIdentities', parameters('identityName')), variables('roles').resourcePolicyContributor)]",
              "properties": {
                "roleDefinitionId": "[subscriptionResourceId('Microsoft.Authorization/roleDefinitions', variables('roles').resourcePolicyContributor)]",
                "principalId": "[reference(resourceId('Microsoft.ManagedIdentity/userAssignedIdentities', parameters('identityName')), '2023-01-31').principalId]",
                "principalType": "ServicePrincipal",
                "description": "GitHub Actions: create the Azure Policy assignments."
              },
              "dependsOn": [
                "[resourceId('Microsoft.ManagedIdentity/userAssignedIdentities', parameters('identityName'))]"
              ]
            },
            {
              "type": "Microsoft.Authorization/roleAssignments",
              "apiVersion": "2022-04-01",
              "name": "[guid(resourceGroup().id, resourceId('Microsoft.ManagedIdentity/userAssignedIdentities', parameters('identityName')), variables('roles').rbacAdministrator)]",
              "properties": {
                "roleDefinitionId": "[subscriptionResourceId('Microsoft.Authorization/roleDefinitions', variables('roles').rbacAdministrator)]",
                "principalId": "[reference(resourceId('Microsoft.ManagedIdentity/userAssignedIdentities', parameters('identityName')), '2023-01-31').principalId]",
                "principalType": "ServicePrincipal",
                "description": "GitHub Actions: assign only AcrPull and AKS RBAC Cluster Admin, only to users and service principals.",
                "condition": "[variables('rbacCondition')]",
                "conditionVersion": "2.0"
              },
              "dependsOn": [
                "[resourceId('Microsoft.ManagedIdentity/userAssignedIdentities', parameters('identityName'))]"
              ]
            }
          ],
          "outputs": {
            "clientId": {
              "type": "string",
              "value": "[reference(resourceId('Microsoft.ManagedIdentity/userAssignedIdentities', parameters('identityName')), '2023-01-31').clientId]"
            },
            "principalId": {
              "type": "string",
              "value": "[reference(resourceId('Microsoft.ManagedIdentity/userAssignedIdentities', parameters('identityName')), '2023-01-31').principalId]"
            },
            "subjects": {
              "type": "array",
              "copy": {
                "count": "[length(variables('credentials'))]",
                "input": "[variables('credentials')[copyIndex()].subject]"
              }
            }
          }
        }
      },
      "dependsOn": [
        "[subscriptionResourceId('Microsoft.Resources/resourceGroups', parameters('resourceGroupName'))]"
      ]
    }
  ],
  "outputs": {
    "resourceGroupName": {
      "type": "string",
      "value": "[parameters('resourceGroupName')]"
    },
    "clientId": {
      "type": "string",
      "value": "[reference(extensionResourceId(format('/subscriptions/{0}/resourceGroups/{1}', subscription().subscriptionId, parameters('resourceGroupName')), 'Microsoft.Resources/deployments', 'github-identity'), '2025-04-01').outputs.clientId.value]"
    },
    "principalId": {
      "type": "string",
      "value": "[reference(extensionResourceId(format('/subscriptions/{0}/resourceGroups/{1}', subscription().subscriptionId, parameters('resourceGroupName')), 'Microsoft.Resources/deployments', 'github-identity'), '2025-04-01').outputs.principalId.value]"
    },
    "tenantId": {
      "type": "string",
      "value": "[tenant().tenantId]"
    },
    "subscriptionId": {
      "type": "string",
      "value": "[subscription().subscriptionId]"
    },
    "federatedSubjects": {
      "type": "array",
      "value": "[reference(extensionResourceId(format('/subscriptions/{0}/resourceGroups/{1}', subscription().subscriptionId, parameters('resourceGroupName')), 'Microsoft.Resources/deployments', 'github-identity'), '2025-04-01').outputs.subjects.value]"
    }
  }
}