# Copy to terraform.tfvars (ignored by git) and fill in the bootstrap outputs.
# scripts/bootstrap.sh passes these values for you.
github_owner          = "<your-github-account>"
repository            = "contoso-health-aks-demo"
azure_client_id       = "<clientId output>"
azure_tenant_id       = "<tenantId output>"
azure_subscription_id = "<subscriptionId output>"
azure_principal_id    = "<principalId output>"
admin_principal_id    = "<your Entra object ID: az ad signed-in-user show --query id -o tsv>"
# extra_variables     = { DNS_LABEL = "contoso-health-myname" }
# copilot_code_review = true
